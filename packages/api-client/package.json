{
  "name": "@stormvpn/api-client",
  "version": "1.0.0",
  "private": true,
  "description": "Typed client for the StormVPN REST + WebSocket API (web, admin and future native apps)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@stormvpn/types": "workspace:*",
    "@stormvpn/validation": "workspace:*"
  }
}
