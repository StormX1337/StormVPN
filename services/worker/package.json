{
  "name": "@stormvpn/worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@stormvpn/config": "workspace:*",
    "@stormvpn/core": "workspace:*",
    "@stormvpn/database": "workspace:*",
    "bullmq": "^6.3.9",
    "ioredis": "^5.11.1",
    "nodemailer": "^10.0.10"
  }
}
