{
  "uid": "stormvpn-overview",
  "title": "StormVPN \u2013 Platform overview",
  "tags": [
    "stormvpn"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Online nodes",
      "datasource": {
        "type": "prometheus",
        "uid": "stormvpn-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(stormvpn_nodes{status=\"ONLINE\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "stormvpn-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
