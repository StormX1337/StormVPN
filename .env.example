# ─────────────────────────────────────────────────────────────────────────────
# StormVPN environment configuration
# Copy to `.env` for local development. NEVER commit real secrets.
# In production inject these via your secret manager / orchestrator.
# Generate secrets with:  openssl rand -base64 48   (JWT)  |  openssl rand -base64 32  (encryption key)
# ─────────────────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

# ── Docker Compose ───────────────────────────────────────────────────────────
# Public base URL of the deployment (used for APP_URL/ADMIN_URL/CORS in compose)
PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ── Datastores ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://stormvpn:stormvpn_dev_password@localhost:5432/stormvpn
REDIS_URL=redis://localhost:6379/0
# Used by docker-compose for the postgres container
POSTGRES_USER=stormvpn
POSTGRES_PASSWORD=stormvpn_dev_password
POSTGRES_DB=stormvpn

# ── API (apps/api) ───────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=4000
# Reverse proxy trust: "loopback", "true", hop count ("1") or comma separated CIDRs
TRUST_PROXY=loopback
# Public URLs (used in emails, Stripe redirects, CORS)
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000/admin
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Access token signing secret (HS256, >= 32 chars)
JWT_ACCESS_SECRET=
JWT_ISSUER=stormvpn-api
JWT_AUDIENCE=stormvpn
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Must be true in production (HTTPS). false only for http://localhost development.
COOKIE_SECURE=false
# COOKIE_DOMAIN=.stormvpn.example

# AES-256-GCM key for secrets at rest (TOTP secrets, WireGuard PSKs): 32 bytes base64
DATA_ENCRYPTION_KEY=
# Previous key during rotation (optional)
# DATA_ENCRYPTION_KEY_PREVIOUS=

# Stripe (optional – without it only free/complimentary plans work)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Prometheus scrape token for GET /metrics (without it only private networks may scrape)
# METRICS_TOKEN=

# Rate limiting & abuse prevention
RATE_LIMIT_MAX_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
REGISTRATION_ENABLED=true
REGISTRATIONS_PER_IP_PER_DAY=5
REQUIRE_EMAIL_VERIFICATION=true

# Node management
NODE_HEARTBEAT_INTERVAL_SECONDS=15
NODE_OFFLINE_AFTER_SECONDS=90
NODE_ENROLLMENT_TTL_HOURS=24
# AGENT_LATEST_VERSION=1.0.0
# AGENT_UPDATE_BASE_URL=https://downloads.stormvpn.example/agent

# WireGuard client defaults
WG_DEFAULT_KEEPALIVE=25
WG_DEFAULT_ALLOWED_IPS=0.0.0.0/0,::/0

# ── Worker (services/worker) ─────────────────────────────────────────────────
MAIL_FROM="StormVPN <no-reply@stormvpn.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
WORKER_CONCURRENCY=5
CONNECTION_STALE_AFTER_SECONDS=300
HEARTBEAT_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=365

# ── Web / Admin (apps/web, apps/admin) ───────────────────────────────────────
# Where the Next.js servers reach the API (server side rewrites)
API_INTERNAL_URL=http://localhost:4000

# ── Seed (development only) ──────────────────────────────────────────────────
# SEED_ADMIN_EMAIL=admin@stormvpn.local
# SEED_ADMIN_PASSWORD=
# SEED_USER_EMAIL=demo@stormvpn.local
# SEED_USER_PASSWORD=
