{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StormVPN",
  "mainBinaryName": "StormVPN",
  "version": "1.0.0",
  "identifier": "app.stormvpn.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StormVPN",
        "width": 440,
        "height": 760,
        "minWidth": 380,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "StormVPN",
    "shortDescription": "StormVPN – WireGuard VPN client",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "binaries/tunnel.dll": "tunnel.dll",
      "binaries/wireguard.dll": "wireguard.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
