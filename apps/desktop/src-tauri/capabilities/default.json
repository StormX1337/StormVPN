{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "StormVPN main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "https://*:*"
        },
        {
          "url": "http://localhost:*"
        }
      ]
    },
    "opener:allow-open-url"
  ]
}
